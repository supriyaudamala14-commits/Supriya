<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>My Skills Portfolio</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, sans-serif;
        }

        body {
            background: #f4f6f8;
            color: #222;
        }

        header {
            background: #222;
            color: white;
            text-align: center;
            padding: 60px 20px;
        }

        header h1 {
            font-size: 40px;
            margin-bottom: 10px;
        }

        header p {
            font-size: 20px;
            color: #ddd;
        }

        nav {
            background: #333;
            text-align: center;
            padding: 15px;
        }

        nav a {
            color: white;
            text-decoration: none;
            margin: 0 15px;
            font-weight: bold;
        }

        nav a:hover {
            color: #00adb5;
        }

        section {
            max-width: 1000px;
            margin: 40px auto;
            padding: 30px;
            background: white;
            border-radius: 10px;
        }

        section h2 {
            text-align: center;
            margin-bottom: 25px;
            color: #00adb5;
        }

        .about {
            text-align: center;
            line-height: 1.7;
        }

        .skills {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
        }

        .skill {
            background: #f4f6f8;
            padding: 25px;
            text-align: center;
            border-radius: 8px;
            transition: 0.3s;
        }

        .skill:hover {
            transform: translateY(-5px);
            background: #00adb5;
            color: white;
        }

        .skill h3 {
            margin-bottom: 10px;
        }

        .projects {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 20px;
        }

        .project {
            padding: 20px;
            border: 1px solid #ddd;
            border-radius: 8px;
        }

        .project h3 {
            margin-bottom: 10px;
            color: #00adb5;
        }

        .contact {
            text-align: center;
            line-height: 2;
        }

        footer {
            text-align: center;
            background: #222;
            color: white;
            padding: 20px;
            margin-top: 40px;
        }
    </style>
</head>

<body>

    <!-- Header -->
    <header>
        <h1>Your Name</h1>
        <p>Student | Web Developer | Programmer</p>
    </header>

    <!-- Navigation -->
    <nav>
        <a href="#about">About</a>
        <a href="#skills">Skills</a>
        <a href="#projects">Projects</a>
        <a href="#contact">Contact</a>
    </nav>

    <!-- About Section -->
    <section id="about">
        <h2>About Me</h2>

        <div class="about">
            <p>
                Hello! I am Your Name. I am interested in technology,
                web development and programming. I enjoy learning new
                skills and creating useful projects.
            </p>
        </div>
    </section>

    <!-- Skills Section -->
    <section id="skills">
        <h2>My Skills</h2>

        <div class="skills">

            <div class="skill">
                <h3>HTML</h3>
                <p>Creating structured and semantic web pages.</p>
            </div>

            <div class="skill">
                <h3>CSS</h3>
                <p>Designing responsive and attractive websites.</p>
            </div>

            <div class="skill">
                <h3>JavaScript</h3>
                <p>Adding interactive features to websites.</p>
            </div>

            <div class="skill">
                <h3>Python</h3>
                <p>Programming and solving problems using Python.</p>
            </div>

            <div class="skill">
                <h3>Communication</h3>
                <p>Good communication and teamwork skills.</p>
            </div>

            <div class="skill">
                <h3>Problem Solving</h3>
                <p>Analyzing problems and finding effective solutions.</p>
            </div>

        </div>
    </section>

    <!-- Projects Section -->
    <section id="projects">
        <h2>My Projects</h2>

        <div class="projects">

            <div class="project">
                <h3>Portfolio Website</h3>
                <p>
                    A personal website created using HTML and CSS
                    to showcase my skills and projects.
                </p>
            </div>

            <div class="project">
                <h3>Student Management System</h3>
                <p>
                    A project designed to manage student information
                    and records.
                </p>
            </div>

            <div class="project">
                <h3>Web Application</h3>
                <p>
                    An interactive web application created using
                    HTML, CSS and JavaScript.
                </p>
            </div>

        </div>
    </section>

    <!-- Contact Section -->
    <section id="contact">
        <h2>Contact Me</h2>

        <div class="contact">
            <p>Email: yourname@email.com</p>
            <p>Phone: +91 XXXXX XXXXX</p>
            <p>GitHub: github.com/yourusername</p>
            <p>LinkedIn: linkedin.com/in/yourusername</p>
        </div>
    </section>

    <!-- Footer -->
    <footer>
        <p>© 2026 Your Name. All Rights Reserved.</p>
    </footer>

</body>
</html>
